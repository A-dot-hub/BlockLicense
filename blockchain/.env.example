# Local or Testnet RPC URL
RPC_URL=http://127.0.0.1:8545
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Private Key for testnet deployment (DO NOT commit your actual private key)
PRIVATE_KEY=your_private_key_here
